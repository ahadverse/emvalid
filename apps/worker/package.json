{
  "name": "@ev/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "verify": "node --env-file-if-exists=../../.env src/verify-file.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@ev/core": "workspace:*",
    "@ev/db": "workspace:*",
    "@ev/pipeline": "workspace:*"
  }
}
